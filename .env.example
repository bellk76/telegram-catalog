# Скопируйте файл в .env и заполните значения.
# Секреты генерируйте командой: openssl rand -hex 32
# POSTGRES_PASSWORD используйте URL-safe (hex): compose подставляет его в DATABASE_URL как есть.

POSTGRES_DB=catalog
POSTGRES_USER=catalog
POSTGRES_PASSWORD=CHANGE_ME

MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_APP_USER=catalog-app
MINIO_APP_PASSWORD=
MINIO_ENDPOINT=minio:9000
MINIO_SECURE=false
MINIO_BUCKET=product-images

BOT_TOKEN=
# Рабочий IPv4 api.telegram.org, если DNS/адрес блокируется (по умолчанию 149.154.167.220)
TELEGRAM_API_IP=149.154.167.220
# Telegram user id админов через запятую: 123456789,987654321
ADMIN_IDS=
# webhook (прод) или polling (локальная отладка)
BOT_MODE=webhook
# Разрешить polling; включайте только локально, один инстанс
ALLOW_POLLING=false
# Публичный HTTPS-URL вида https://<host>/telegram/webhook; web проксирует /telegram/* в bot
TELEGRAM_WEBHOOK_URL=
# Секрет заголовка X-Telegram-Bot-Api-Secret-Token; обязателен при заданном TELEGRAM_WEBHOOK_URL
TELEGRAM_WEBHOOK_SECRET=
# Публичный HTTPS-адрес каталога (Mini App), тот же origin: https://<host>/
WEBAPP_URL=

# Внутренний токен bot -> api (заголовок X-Internal-Token)
API_INTERNAL_TOKEN=
# Внутренний адрес API в compose-сети
API_INTERNAL_URL=http://api:8000
# Внутренний адрес бота: web проксирует /telegram/* (webhook) в бот
BOT_INTERNAL_URL=http://bot:8080
# JSON-массив origin для CORS (не нужен при работе через web, single origin)
CORS_ORIGINS=["http://localhost:3000"]
# Максимальный размер изображения в байтах
MAX_IMAGE_BYTES=5242880
# Пул соединений БД на одну реплику API
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
